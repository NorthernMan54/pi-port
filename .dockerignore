# Build context is the repo root (see docker/Dockerfile).
.git
.github
rknn_convert/
docs/
# Superseded duplicated CPU tree (only present if checked out from the old branch)
piport/x86/
**/__pycache__
**/*.pyc
**/*.pyo
**/.venv
**/instances/
# Runtime state must never enter the image (a stale cert here made every
# container fail load_cert_chain). Use **/ so patterns match subdirectories --
# a bare "*.key" only matches the context root, not piport/server.key.
*.log
**/*.log
**/*.pem
**/*.key
**/*.crt
**/server.crt
**/server.key
**/adopt_state.json
**/adopt_state.json.tmp
**/fw_version.json
**/device_name
**/*.bak-preinstall
# Model binaries: the image fetches its own (sha256-pinned).
**/*.onnx
**/*.rknn
**/*.tflite
