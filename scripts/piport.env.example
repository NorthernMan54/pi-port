# Settings for scripts/piport_service.sh (and the launchd agent scripts/macos_launchd.sh installs):
# copy to ~/.pi-port/<instance>/piport.env ("native" for the main one) and edit.
# One KEY=value per line (no spaces around =, no quotes needed). Only AIPORT_* and PIPORT_*
# keys are used. Edit, then touch the instance's restart file
# (~/.pi-port/native/restart) to apply.

# Identity: the adopted AI Port this host runs as (scripts/macos_move_host.sh moves it to another Mac).
PIPORT_IFACE=en0
# PIPORT_STATE_DIR is the instance's state/ folder unless set here.
PIPORT_MAC=020000000001
PIPORT_DEVICE_ID=fe6488e7-7042-5bcb-ab86-6f0ad1a5baed
# A second instance on the same Mac needs its own address, MAC and device ID. As a root daemon
# (macos_launchd.sh install --daemon) it adds PIPORT_BIND_IP to PIPORT_IFACE at every start;
# AIPORT_ADVERTISE_IP is the address Protect is told.
# PIPORT_BIND_IP=192.0.2.39
# AIPORT_ADVERTISE_IP=192.0.2.39

# Protect console and detection settings (piport/README.md lists them all).
AIPORT_CONSOLE_HOST=192.0.2.1
AIPORT_MODEL_PATH=/Users/you/Code/pi-port/piport/models/yolov9-s-320.onnx
AIPORT_TICK_S=0.2
AIPORT_BOX_DELAY_MS=1500,02000000000B=1800
AIPORT_TRUE_THRESH=0.7,vehicle=0.6
AIPORT_MOTION_CONTOUR_AREA=10,02000000000B=100
# Report each camera at half the real device's capacity points, so twice as many pair.
# AIPORT_POINTS_SCALE=0.5
# logs/piport.log is rotated at this many MB, keeping this many old files (piport.log.1 ...).
# Read at service start: apply with scripts/macos_launchd.sh restart, not the restart file.
# PIPORT_LOG_MAX_MB=50
# PIPORT_LOG_KEEP=5
